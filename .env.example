# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
API_PUBLIC_URL=http://localhost:4000
PLATFORM_DOMAIN=dukadesk.app
PLATFORM_URL=https://dukadesk.app

# Database
DATABASE_URL=postgresql://dukadesk:dukadesk@localhost:5432/dukadesk

# Redis (set REDIS_URL for production, or REDIS_HOST+REDIS_PORT for dev)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Auth
OTP_EXPIRATION=5

# Optional bootstrap account. Set both in a secret manager to provision an account.
# The password must be at least 16 characters. No default super admin is created.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Storage (S3-compatible)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=dukadesk
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# CORS — comma-separated extra origins. *.netlify.app, *.railway.app and
# localhost are always allowed (see src/main.ts). '*' allows everything.
CORS_ORIGINS=*

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Apple Sign-In
APPLE_CLIENT_ID=your-apple-service-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey.p8
APPLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/apple/callback

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Payment Providers
PAYSTACK_SECRET_KEY=sk_test_placeholder
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder

# Notifications
# EMAIL_PROVIDER: log | sendgrid | resend | ses | smtp  (use 'resend' to deliver OTP via Resend's test sender)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=RESEND_API_KEY_PLACEHOLDER
EMAIL_FROM_NAME=DUKADESK
EMAIL_FROM_EMAIL=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

PUSH_PROVIDER=log
FCM_SERVER_KEY=

SMS_PROVIDER=log
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=DUKADESK

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Demo business data is opt-in and always disabled in production.
SEED_SAMPLE_DATA=false
